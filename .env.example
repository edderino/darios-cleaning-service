# Frontend — where the contact form POSTs to. Defaults to the local
# Vercel serverless function (/api/contact) if unset. Point this at a
# shared, multi-client contact API later (see README) without touching
# any component code.
VITE_CONTACT_API_URL=/api/contact

# Backend (api/contact.js) — Mailgun credentials. Server-side only, never
# exposed to the browser. Set these in the Vercel project's Environment
# Variables, not in a committed file.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_TO=dariogaz@outlook.com
MAILGUN_FROM="Dario's Cleaning Service <noreply@yourmailgundomain>"
